# ============================================================================
# docker compose 用的变量（复制成 .env 后按需修改）
#
#   cp .env.example .env
#
# 注意：后端自己的配置在 server/.env（compose 里通过 env_file 注入），
# 这里是给 compose 文件做 ${VAR} 替换用的，两者不要混。
# ============================================================================

# MySQL root 密码（生产必须改！改完 mysql 与 backend 会一起生效）
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=chuangzhibei

# Chroma 镜像版本：与后端 python 包 chromadb 版本尽量对齐，
# 否则可能出现索引读写不一致（见 docs/vectorstore.md）
CHROMA_VERSION=1.5.9

# 对外暴露的端口（前端 Nginx）
WEB_PORT=80
