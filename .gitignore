# 本机 git 环境适配文件（SteamTools 中间人根证书合并包），不提交
.git-trust/

# 依赖
node_modules/
vendor/

# Python 虚拟环境与字节码
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 后端运行数据（SQLite 数据库与上传文件，删除后重启会自动重建演示数据）
server/data/

# 构建产物
dist/
build/
out/
*.log

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 环境变量与密钥
.env
.env.local
.env.*.local
*.pem

# 依赖锁文件保留（package-lock.json / pnpm-lock.yaml 应提交）

# 临时 / 本地数据
*.tmp
*.local
coverage/
.cache/

# npm 本地缓存（本机安装依赖时指定在工作区内）
.npm-cache/

# Python（rag/ 目录）
__pycache__/
*.py[cod]
.venv/
venv/
rag/.env
rag/.pylibs/

# 向量库（本地生成，体积大，可用 build_db.py 重建；不入库）
chroma_db/
rag/chroma_db/
# ChromaDB 的临时/探测目录（排查时会在当前目录生成）
# 注意：不写尾斜杠，否则对「尚不存在的路径」不生效
chroma_probe_*
chroma_*

# 原始语料（体积大，不入库）
rag/*.pdf

# pip 遗留的临时目录（含拒绝删除权限项，无法清理，忽略）
.tmp-pip/
