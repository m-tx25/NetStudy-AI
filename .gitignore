# 本机 git 环境适配文件（SteamTools 中间人根证书合并包），不提交
.git-trust/

# 依赖
node_modules/
vendor/

# Python 虚拟环境与字节码
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 后端运行数据（SQLite 数据库与上传文件，删除后重启会自动重建演示数据）
server/data/

# 构建产物
dist/
build/
out/
*.log

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 环境变量与密钥
.env
.env.local
.env.*.local
*.pem

# 依赖锁文件保留（package-lock.json / pnpm-lock.yaml 应提交）

# 临时 / 本地数据
*.tmp
*.local
coverage/
.cache/

# npm 本地缓存（本机安装依赖时指定在工作区内）
.npm-cache/
