# ---------------------------------------------------------------
# 后端环境变量模板
# 使用：复制为 .env 后按需修改（.env 已在 .gitignore 中忽略）
# ---------------------------------------------------------------

# ---------------- 基础 ----------------
DEBUG=true
HOST=0.0.0.0
PORT=3000
# 允许跨域的前端源，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 关系型数据库：MySQL ----------------
# 存放业务数据：用户、知识库、文档元信息、会话、消息、引用。
# 库不存在时会自动创建（utf8mb4）。
#
# ⚠️ MYSQL_PASSWORD 必须改成**你本机 MySQL 的真实密码**，否则后端启动会报
#    「无法连接 MySQL」。用下文的 docker compose 起库时，密码是 chuangzhibei。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 这里只是占位，请按实际情况修改（Docker 方式为 chuangzhibei）
MYSQL_PASSWORD=root
MYSQL_DATABASE=chuangzhibei

# 也可直接指定完整 DSN（设置后上面的 MYSQL_* 失效）
# DATABASE_URL=mysql+aiomysql://root:密码@127.0.0.1:3306/chuangzhibei?charset=utf8mb4

# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# 无 MySQL 时的临时回退（正常开发不要开启）：
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------------- 鉴权 ----------------
# 生产环境必须替换！生成方式：openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------- 上传 ----------------
# 与前端 client/src/config/index.js 的 UPLOAD_LIMITS.maxSizeMB 保持一致
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# ---------------- 向量化：智谱 embedding-3 ----------------
# 与协作者 rag/ 模块同一方案。申请地址：https://open.bigmodel.cn/
# 变量名必须是 ZHIPUAI_API_KEY（LangChain 的 ZhipuAIEmbeddings 读这个），
# Key 形如 xxxxxxxx.xxxxxxxx，不是 sk- 开头。
# 留空则退化为 Chroma 自带嵌入函数（中文检索效果一般，仅保证链路可跑通）。
ZHIPUAI_API_KEY=
ZHIPUAI_EMBEDDING_MODEL=embedding-3
# embedding-3 支持 256/512/1024/2048
ZHIPUAI_EMBEDDING_DIM=2048

# ---------------- 向量库：ChromaDB ----------------
CHROMA_PERSIST_DIR=./data/chroma_db
# 实际集合名会追加向量空间后缀（zhipu2048 / default）
CHROMA_COLLECTION=knowledge_chunks
# 混合检索：0.5×向量相似度 + 0.5×词面命中（术语/公式类文档推荐开启）
HYBRID_SEARCH=true

# ---------------- 大模型（生成环节，OpenAI 兼容）----------------
# 注意：DeepSeek 没有 /embeddings 接口，只能用于生成，不能用于向量化。
# 任何兼容 /chat/completions 的服务都可以：DeepSeek、通义千问、智谱、Moonshot、
# vLLM、Ollama、One-API 等。填好 LLM_API_KEY 后问答即可真实生成。
#
# 常用服务商（也可直接用前端「密钥」页面填写，无需改本文件）：
#   DeepSeek    https://api.deepseek.com/v1                          model=deepseek-chat
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1    model=qwen-plus
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4                 model=glm-4-plus
#   Moonshot     https://api.moonshot.cn/v1                           model=moonshot-v1-8k
#   本地 Ollama  http://127.0.0.1:11434/v1                            model=qwen2.5:7b
#
# 模型名必须是服务商**当前支持**的名字，写错会返回 400
# 「The supported API model names are ...」—— 按提示里的名字改正即可。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120

# ---------------- RAG 参数 ----------------
# 与 rag/build_db.py 的 500/50 对齐
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
SCORE_THRESHOLD=0.2
# 注入 prompt 的历史轮数（一问一答算一轮）
MEMORY_TURNS=6

# ---------------- Celery / Redis ----------------
REDIS_URL=redis://127.0.0.1:6379/0
# 本地没有 Redis 时设为 true：文档处理在 Web 进程内执行（仅适合开发）。
#
# ⚠️ 默认 true —— 这样**不需要安装 Redis** 也能完整跑通「上传 → 解析 → 向量化」。
#    若设为 false 而本机没有 Redis，上传的文档会直接变成 failed
#    （任务投递失败），看起来像系统坏了。
#    有 Redis 且想体验真实异步队列时，改成 false 并另起 celery worker。
CELERY_TASK_ALWAYS_EAGER=true

# 仅在上面的 EAGER 为 true 时生效：
#   true（默认）—— 立即返回 processing，解析在后台协程继续，前端轮询拿到最终状态。
#                  与「Redis + Celery worker」的真实异步语义一致，且无需 Redis。
#   false        —— 接口内同步等待解析完成，返回时已是 ready。省事，但看不到「解析中」。
CELERY_EAGER_ASYNC=true

# 演示/排查用：让文档解析前先等待若干秒，便于观察前端「解析中 → 已就绪」。
# 默认 0（不生效）；生产环境不要设置。
PIPELINE_ARTIFICIAL_DELAY_SECONDS=0
