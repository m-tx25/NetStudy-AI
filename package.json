{
  "name": "matrix-scholar",
  "private": true,
  "version": "0.1.0",
  "description": "传智杯 Web 方向参赛项目：苍穹矩阵（Matrix-Scholar RAG Engine）—— Vue 3 + Vite 前端 / Python + FastAPI 后端",
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev": "node scripts/dev.mjs",
    "install:client": "npm --prefix client install",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "check:build": "npm --prefix client run check:build",
    "check:e2e": "npm --prefix client run check:e2e",
    "screenshots": "npm --prefix client run screenshots",
    "check:server": "node scripts/verify-backend-contract.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
