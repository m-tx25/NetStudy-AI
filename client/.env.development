# ---------------------------------------------------------------
# 开发环境变量（Vite 只会把 VITE_ 前缀的变量暴露给浏览器）
# ---------------------------------------------------------------

# 后端 API 前缀。默认走 Vite 代理（见 vite.config.js 的 server.proxy），
# 因此这里保持 /api 即可；若后端独立部署，可写成 https://api.example.com/api
VITE_API_BASE_URL=/api

# 是否启用内置 Mock 数据（true / false）
# true  ：无需后端即可完整演示登录、问答流式输出、知识库上传管理
# false ：所有请求真实打到 VITE_API_BASE_URL
VITE_USE_MOCK=true

# 应用标题（会显示在登录页与侧边栏）
VITE_APP_TITLE=RAG 知识问答系统

# 登录页/注册页页脚展示用。正式上线前请替换为真实主体信息。
VITE_COMPANY_NAME=RAG 知识问答系统项目组
# 备案号留空则不显示；填写示例：京ICP备00000000号-1
VITE_ICP_LICENSE=京ICP备00000000号-1
VITE_SUPPORT_EMAIL=support@example.com
