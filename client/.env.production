# 生产构建环境变量
#
# 生产环境默认**不**启用 Mock，所有请求真实打到 VITE_API_BASE_URL。
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false
VITE_APP_TITLE=RAG 知识问答系统

# 登录页/注册页页脚。正式上线前请替换为真实主体信息与备案号。
VITE_COMPANY_NAME=RAG 知识问答系统项目组
VITE_ICP_LICENSE=京ICP备00000000号-1
VITE_SUPPORT_EMAIL=support@example.com

# 如果只想交付一个纯前端演示包（无后端也能点开看），把上面改成：
#   VITE_USE_MOCK=true
# 然后重新执行 pnpm build 即可，构建产物会带上内置演示数据。
